<Project>
  <!-- Directory.Build.props limits central management to repository tooling. -->
  <PropertyGroup Condition="'$(_KijiRepositoryProject)' == 'true'">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Condition="'$(_KijiRepositoryProject)' == 'true'">
    <PackageVersion Include="CliWrap" Version="3.10.5" />
    <PackageVersion Include="Microsoft.Playwright.Xunit.v3" Version="1.63.0" />
    <PackageVersion Include="Microsoft.TemplateEngine.Authoring.Tasks" Version="10.0.403" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>
</Project>
