<Project>
  <PropertyGroup>
    <!-- Apply repository defaults to tools in src/ and projects directly below it.
         Template sources and generated projects must remain self-contained. -->
    <_KijiSourceDirectory>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'src'))</_KijiSourceDirectory>
    <_KijiProjectParentDirectory>$([System.IO.Path]::GetDirectoryName('$(MSBuildProjectDirectory)'))</_KijiProjectParentDirectory>
    <_KijiRepositoryProject Condition="'$(MSBuildProjectDirectory)' == '$(_KijiSourceDirectory)' Or '$(_KijiProjectParentDirectory)' == '$(_KijiSourceDirectory)'">true</_KijiRepositoryProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_KijiRepositoryProject)' == 'true'">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_KijiRepositoryProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <Authors>zzzkan</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zzzkan/Kiji.Templates</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/zzzkan/Kiji.Templates</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
