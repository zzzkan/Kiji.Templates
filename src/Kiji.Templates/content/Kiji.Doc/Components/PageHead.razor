@inject SiteInfo Site
@inject PageInfo Page

<PageTitle>@DisplayTitle</PageTitle>

<HeadContent>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="stylesheet" href="@(PrismBaseUrl + "/themes/prism.min.css")" media="(prefers-color-scheme: light)" />
    <link rel="stylesheet" href="@(PrismBaseUrl + "/themes/prism-tomorrow.min.css")"
          media="(prefers-color-scheme: dark)" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["Kiji.Doc.styles.css"]" />
    <script src="@(PrismBaseUrl + "/components/prism-core.min.js")" defer></script>
    <script src="@(PrismBaseUrl + "/plugins/autoloader/prism-autoloader.min.js")" defer></script>
    <link rel="icon" type="image/svg+xml"
          href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ctext x='32' y='52' text-anchor='middle' font-size='52'%3E%F0%9F%93%96%3C/text%3E%3C/svg%3E" />
    <meta name="description" content="@PageDescription" />
    <meta name="author" content="@Site.Author" />
    <link rel="canonical" href="@Page.Url.AbsoluteUri" />
    <meta property="og:title" content="@DisplayTitle" />
    <meta property="og:description" content="@PageDescription" />
    <meta property="og:url" content="@Page.Url.AbsoluteUri" />
    <meta property="og:site_name" content="@Site.Name" />
    <meta property="og:type" content="website" />
</HeadContent>

@code {
    private const string PrismBaseUrl = "https://cdn.jsdelivr.net/npm/prismjs@1.30.0";
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    private string DisplayTitle => $"{Title} - {Site.Name}";
    private string? PageDescription => string.IsNullOrWhiteSpace(Description) ? Site.Description : Description;
}
