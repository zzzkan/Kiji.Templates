@page "/docs/{Slug}/"

<PageHead Title="@Article.Title" Description="@Article.Description" />
<article>
    <h1>@Article.Title</h1>
    <div class="doc-content"><MarkdownBody Content="Article.Content" /></div>
</article>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public Article Article { get; set; } = null!;
}
