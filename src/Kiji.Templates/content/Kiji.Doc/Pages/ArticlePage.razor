@page "/docs/{Slug}/"
@{ var frontMatter = Article.Content.FrontMatter; }

<PageHead Title="@frontMatter.Title" Description="@frontMatter.Description" />
<article>
    <h1>@frontMatter.Title</h1>
    <div class="doc-content"><MarkdownBody Content="Article.Content" /></div>
</article>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public Article Article { get; set; } = null!;
}
