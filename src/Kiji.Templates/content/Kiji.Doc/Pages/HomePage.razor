@page "/"
@inject SiteInfo Site
@inject ContentDictionary<Article> Articles

<PageHead Title="Home" />
<div class="hero">
    <h1>@Site.Name</h1>
    <p class="lede">@Site.Description</p>
</div>
<section class="pitch" aria-label="Documentation overview">
    @foreach (var article in Articles.Values.OrderBy(article => article.Order).ThenBy(article => article.Slug, StringComparer.Ordinal))
    {
        <article>
            <h2><a href="@Site.ResolveUrl(article.RelativePath).AbsolutePath">@article.Title</a></h2>
            <p>@article.Description</p>
        </article>
    }
</section>
