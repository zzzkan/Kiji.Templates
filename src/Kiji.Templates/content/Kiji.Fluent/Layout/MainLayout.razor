@inherits LayoutComponentBase
@inject SiteInfo Site
@inject PageInfo Page

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
    <a class="brand" href="@Site.ResolveUrl("").AbsolutePath">
        <span class="emoji" aria-hidden="true">🏢</span>
        <span>@Site.Name</span>
    </a>
    <nav aria-label="Main navigation">
        <a href="@Site.ResolveUrl("").AbsolutePath" aria-current="@(Page.Url.AbsolutePath == Site.ResolveUrl("").AbsolutePath ? "page" : null)">Overview</a>
        <a href="@Site.ResolveUrl("").AbsolutePath#services">Capabilities</a>
        <a href="@Site.ResolveUrl("").AbsolutePath#resources">Resources</a>
        <a href="@Site.ResolveUrl("").AbsolutePath#plan">Plan your project</a>
    </nav>
</header>
<main id="main-content" tabindex="-1">@Body</main>
<footer class="site-footer">
    <span>@Site.Name</span>
    <a href="@Site.ResolveUrl("").AbsolutePath#plan">Plan your project</a>
</footer>
