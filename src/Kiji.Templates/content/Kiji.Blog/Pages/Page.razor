@page "/{Slug}/"

<PageHead Title="@PageContent.Title" Description="@PageContent.Description" />
<h1>@PageContent.Title</h1>
<div class="prose"><MarkdownBody Content="PageContent.Content" /></div>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public SitePage PageContent { get; set; } = null!;
}
