@page "/posts/{Slug}/"

<PageHead Title="@PostContent.Title" Description="@PostContent.Description" PublishedAt="@PostContent.Date" />
<article>
    <header class="post-header">
        <h1>@PostContent.Title</h1>
        <time datetime="@PostContent.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@PostContent.Date.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</time>
    </header>
    <div class="prose"><MarkdownBody Content="PostContent.Content" /></div>
</article>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public BlogPost PostContent { get; set; } = null!;
}
