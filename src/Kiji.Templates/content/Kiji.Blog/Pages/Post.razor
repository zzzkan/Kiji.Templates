@page "/posts/{Slug}/"
@{ var frontMatter = PostContent.Content.FrontMatter; }

<PageHead Title="@frontMatter.Title" Description="@frontMatter.Description" PublishedAt="@frontMatter.Date" />
<article>
    <header class="post-header">
        <h1>@frontMatter.Title</h1>
        <time datetime="@frontMatter.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@frontMatter.Date.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</time>
    </header>
    <div class="prose"><MarkdownBody Content="PostContent.Content" /></div>
</article>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public BlogPost PostContent { get; set; } = null!;
}
