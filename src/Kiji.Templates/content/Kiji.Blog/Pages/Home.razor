@page "/"
@inject SiteInfo Site
@inject ContentCollection<BlogPost> Posts

<PageHead Title="Home" />

<h1>A place for small notes</h1>
<p>@Site.Description</p>

<section aria-labelledby="posts-heading">
    <h2 id="posts-heading">Posts</h2>
    <ul class="post-list">
        @foreach (var post in Posts.OrderByDescending(post => post.Content.FrontMatter.Date).ThenBy(post => post.Slug, StringComparer.Ordinal))
        {
            var frontMatter = post.Content.FrontMatter;
            <li>
                <time datetime="@frontMatter.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@frontMatter.Date.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</time>
                <a href="@Site.ResolveUrl(Post.PathFor(post.Slug)).AbsolutePath">@frontMatter.Title</a>
            </li>
        }
    </ul>
</section>
