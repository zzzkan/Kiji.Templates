{
  "$schema": "https://json.schemastore.org/template",
  "author": "zzzkan",
  "classifications": ["Web", "Static Site"],
  "identity": "Kiji.Interactive",
  "name": "Kiji Interactive",
  "description": "Familiar Blazor template pages with JavaScript interactions.",
  "shortName": "kiji-interactive",
  "sourceName": "Kiji.Interactive",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "constraints": {
    "sdk": {
      "type": "sdk-version",
      "args": "[10.0.100,)"
    }
  },
  "symbols": {
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Skip the automatic restore of the project on create."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": ["dist/**", "**/.kiji/**", "**/.vs/**"]
        }
      ]
    }
  ],
  "primaryOutputs": [{ "path": "Kiji.Interactive.csproj" }],
  "postActions": [
    {
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [{ "text": "Run 'dotnet restore'." }],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
