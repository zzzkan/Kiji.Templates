@page "/counter/"

<PageHead PageTitle="Counter" Description="A simple interactive counter." />

<h1>Counter</h1>

<div data-counter>
    <p role="status">Current count: <span data-count>0</span></p>
    <button type="button" class="btn btn-primary" disabled>Click me</button>
</div>
<noscript><p>Enable JavaScript to use the counter.</p></noscript>

<script type="module" src="@Assets["Pages/Counter.razor.js"]"></script>
