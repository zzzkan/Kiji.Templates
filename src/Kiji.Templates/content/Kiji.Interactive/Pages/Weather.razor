@page "/weather/"

<PageHead PageTitle="Weather" Description="Weather forecasts loaded from sample data." />

<h1>Weather</h1>
<p>This component demonstrates fetching data from the server.</p>

<div data-weather data-url="@Assets["sample-data/weather.json"]">
    <p role="status" hidden><em></em></p>
    <div class="table-responsive" hidden>
        <table class="table">
            <caption class="visually-hidden">Weather forecast</caption>
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col" aria-label="Temperature in Celsius">Temp. (C)</th>
                    <th scope="col" aria-label="Temperature in Fahrenheit">Temp. (F)</th>
                    <th scope="col">Summary</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
<noscript><p>Enable JavaScript to load the weather forecast.</p></noscript>

<script type="module" src="@Assets["Pages/Weather.razor.js"]"></script>
