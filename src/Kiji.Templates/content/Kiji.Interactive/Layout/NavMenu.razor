@inject SiteInfo Site
@inject PageInfo Page

<StaticHeadContent>
    <script type="module" src="@Assets["Layout/NavMenu.razor.js"]"></script>
</StaticHeadContent>

<div data-nav-menu>
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Site.ResolveUrl("").AbsolutePath">@Site.Name</a>
            <button type="button" title="Navigation menu" class="navbar-toggler" aria-label="Navigation menu"
                    aria-controls="site-navigation" aria-expanded="true" hidden>
                <span class="navbar-toggler-icon" aria-hidden="true"></span>
            </button>
        </div>
    </div>

    <div id="site-navigation" class="nav-scrollable">
        <nav class="nav flex-column" aria-label="Main navigation">
            <div class="nav-item px-3">
                <a class="@LinkClass("")" href="@Site.ResolveUrl("").AbsolutePath" aria-current="@Current("")">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </a>
            </div>
            <div class="nav-item px-3">
                <a class="@LinkClass("counter/")" href="@Site.ResolveUrl("counter/").AbsolutePath" aria-current="@Current("counter/")">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
                </a>
            </div>
            <div class="nav-item px-3">
                <a class="@LinkClass("weather/")" href="@Site.ResolveUrl("weather/").AbsolutePath" aria-current="@Current("weather/")">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
                </a>
            </div>
        </nav>
    </div>
</div>

@code {
    private string? Current(string path) =>
        Page.Url.AbsolutePath == Site.ResolveUrl(path).AbsolutePath ? "page" : null;

    private string LinkClass(string path) => Current(path) is null ? "nav-link" : "nav-link active";
}
