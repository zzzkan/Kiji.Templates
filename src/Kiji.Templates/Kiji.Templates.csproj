<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Kiji.Templates</PackageId>
    <PackageType>Template</PackageType>
    <Description>Project templates for Kiji, a static site generator for .NET.</Description>
    <PackageTags>dotnet-new;templates;kiji</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <ValidateTemplatesPath>$(MSBuildProjectDirectory)/content</ValidateTemplatesPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.TemplateEngine.Authoring.Tasks" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="content/**/*"
             Exclude="content/**/bin/**;content/**/obj/**;content/*/dist/**;content/**/.kiji/**;content/**/.vs/**"
             PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="**/*" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
